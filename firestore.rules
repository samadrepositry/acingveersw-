rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ('email_verified' in request.auth.token &&
         request.auth.token.email_verified == true &&
         'email' in request.auth.token &&
         request.auth.token.email == 'abdulsamadrind350@gmail.com')
      );
    }

    function isValidActorProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 80 &&
             data.stageName is string && data.stageName.size() >= 1 && data.stageName.size() <= 60 &&
             data.country is string && data.country.size() >= 1 && data.country.size() <= 60 &&
             data.preferredLanguage in ['en', 'ur', 'hi'] &&
             data.experienceLevel is string && data.experienceLevel.size() >= 1 && data.experienceLevel.size() <= 40 &&
             data.interests is list && data.interests.size() <= 10 &&
             (data.interests.size() == 0 || data.interests[0] is string) &&
             data.isAdultConfirmed is bool &&
             data.hidePublicRanking is bool &&
             data.xp is int && data.xp >= 0 && data.xp <= 10000000 &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000 &&
             data.totalPracticeSeconds is int && data.totalPracticeSeconds >= 0 && data.totalPracticeSeconds <= 100000000 &&
             data.exercisesCompleted is int && data.exercisesCompleted >= 0 && data.exercisesCompleted <= 100000 &&
             data.voiceScore is int && data.voiceScore >= 0 && data.voiceScore <= 100 &&
             data.actingScore is int && data.actingScore >= 0 && data.actingScore <= 100 &&
             data.movementScore is int && data.movementScore >= 0 && data.movementScore <= 100 &&
             data.subscriptionTier in ['free', 'pro', 'premium'] &&
             data.isSuspended is bool &&
             (!('city' in data) || (data.city is string && data.city.size() <= 60)) &&
             (!('actingGoals' in data) || (data.actingGoals is string && data.actingGoals.size() <= 300)) &&
             (!('dailyGoalMinutes' in data) || (data.dailyGoalMinutes is int && data.dailyGoalMinutes >= 5 && data.dailyGoalMinutes <= 300)) &&
             (!('onboardingComplete' in data) || data.onboardingComplete is bool);
    }

    function isValidSession(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.exerciseId is string && data.exerciseId.size() >= 1 && data.exerciseId.size() <= 80 &&
             data.exerciseTitle is string && data.exerciseTitle.size() >= 1 && data.exerciseTitle.size() <= 120 &&
             data.departmentId is string && data.departmentId.size() >= 1 && data.departmentId.size() <= 40 &&
             data.durationSeconds is int && data.durationSeconds >= 1 && data.durationSeconds <= 14400 &&
             data.repetitions is int && data.repetitions >= 0 && data.repetitions <= 500 &&
             data.xpEarned is int && data.xpEarned >= 0 && data.xpEarned <= 5000 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    function isValidChecklistItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.timeOfDay in ['morning', 'afternoon', 'evening'] &&
             data.departmentId is string && data.departmentId.size() >= 1 && data.departmentId.size() <= 40 &&
             data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 180 &&
             data.isCompleted is bool &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 500;
    }

    function isValidStudioRecording(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.studioType in ['voice', 'camera'] &&
             data.localFilePath is string && data.localFilePath.size() >= 1 && data.localFilePath.size() <= 500 &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 3600 &&
             (!('estimatedWpm' in data) || (data.estimatedWpm is int && data.estimatedWpm >= 0 && data.estimatedWpm <= 500)) &&
             (!('fillerWordsCount' in data) || (data.fillerWordsCount is int && data.fillerWordsCount >= 0 && data.fillerWordsCount <= 500)) &&
             (!('framingPreset' in data) || (data.framingPreset is string && data.framingPreset.size() <= 40)) &&
             (!('aiFeedback' in data) || (data.aiFeedback is string && data.aiFeedback.size() <= 4000)) &&
             (!('personalNotes' in data) || (data.personalNotes is string && data.personalNotes.size() <= 1000));
    }

    function isValidCareerItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.itemType in ['credit', 'audition', 'goal', 'headshot'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.status is string && data.status.size() >= 1 && data.status.size() <= 40 &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 120)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('mediaUri' in data) || (data.mediaUri is string && data.mediaUri.size() <= 500));
    }

    function isValidCommunityPost(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorStageName is string && data.authorStageName.size() >= 1 && data.authorStageName.size() <= 60 &&
             data.country is string && data.country.size() >= 1 && data.country.size() <= 60 &&
             data.language is string && data.language.size() >= 1 && data.language.size() <= 20 &&
             data.category in ['discussion', 'challenge', 'collaboration', 'feedback'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 2000 &&
             data.likesCount is int && data.likesCount >= 0 && data.likesCount <= 1000000 &&
             data.reportCount is int && data.reportCount >= 0 && data.reportCount <= 100000 &&
             data.isHidden is bool;
    }

    function isValidModerationReport(data) {
      return data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128 &&
             data.postId is string && isValidId(data.postId) &&
             data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 500 &&
             data.status in ['open', 'resolved', 'dismissed'];
    }

    function isValidCustomExercise(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.departmentId is string && data.departmentId.size() >= 1 && data.departmentId.size() <= 40 &&
             data.difficulty is string && data.difficulty.size() >= 1 && data.difficulty.size() <= 30 &&
             data.durationSeconds is int && data.durationSeconds >= 15 && data.durationSeconds <= 7200 &&
             data.instructions is string && data.instructions.size() >= 5 && data.instructions.size() <= 3000 &&
             data.isPublished is bool &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             (!('correctTechnique' in data) || (data.correctTechnique is string && data.correctTechnique.size() <= 1500)) &&
             (!('commonMistakes' in data) || (data.commonMistakes is string && data.commonMistakes.size() <= 1500)) &&
             (!('objective' in data) || (data.objective is string && data.objective.size() <= 500));
    }

    // 1. User Profiles (PII-isolated: owner or admin only)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().subscriptionTier == 'free' &&
                       incoming().isSuspended == false &&
                       incoming().keys().hasAll([
                         'userId', 'fullName', 'stageName', 'country', 'preferredLanguage',
                         'experienceLevel', 'interests', 'isAdultConfirmed', 'hidePublicRanking',
                         'xp', 'streakDays', 'totalPracticeSeconds', 'exercisesCompleted',
                         'voiceScore', 'actingScore', 'movementScore', 'subscriptionTier',
                         'isSuspended', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'fullName', 'stageName', 'country', 'city', 'preferredLanguage',
                         'experienceLevel', 'interests', 'actingGoals', 'isAdultConfirmed',
                         'hidePublicRanking', 'dailyGoalMinutes', 'onboardingComplete',
                         'xp', 'streakDays', 'totalPracticeSeconds', 'exercisesCompleted',
                         'voiceScore', 'actingScore', 'movementScore', 'subscriptionTier',
                         'isSuspended', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidActorProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidActorProfile(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().userId == existing().userId &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         isAdmin() ||
                         (
                           request.auth.uid == userId &&
                           incoming().subscriptionTier == existing().subscriptionTier &&
                           incoming().isSuspended == existing().isSuspended &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'fullName', 'stageName', 'country', 'city', 'preferredLanguage',
                             'experienceLevel', 'interests', 'actingGoals', 'isAdultConfirmed',
                             'hidePublicRanking', 'dailyGoalMinutes', 'onboardingComplete',
                             'xp', 'streakDays', 'totalPracticeSeconds', 'exercisesCompleted',
                             'voiceScore', 'actingScore', 'movementScore', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());

      // 2. Exercise Sessions subcollection
      match /sessions/{sessionId} {
        allow get: if isSignedIn() && isValidId(sessionId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(sessionId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'exerciseId', 'exerciseTitle', 'departmentId',
                           'durationSeconds', 'repetitions', 'xpEarned', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'exerciseId', 'exerciseTitle', 'departmentId',
                           'durationSeconds', 'repetitions', 'xpEarned', 'notes', 'createdAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidSession(incoming());

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(sessionId) && request.auth.uid == userId;
      }

      // 3. Daily Training Checklist subcollection
      match /checklist/{itemId} {
        allow get: if isSignedIn() && isValidId(itemId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(itemId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'timeOfDay', 'departmentId',
                           'durationMinutes', 'isCompleted', 'sortOrder', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'timeOfDay', 'departmentId',
                           'durationMinutes', 'isCompleted', 'sortOrder', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidChecklistItem(incoming());

        allow update: if isSignedIn() &&
                         isValidId(itemId) &&
                         request.auth.uid == userId &&
                         isValidChecklistItem(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'timeOfDay', 'departmentId', 'durationMinutes', 'isCompleted', 'sortOrder', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(itemId) && request.auth.uid == userId;
      }

      // 4. Studio Recordings metadata subcollection (strictly private to owner)
      match /recordings/{recordingId} {
        allow get: if isSignedIn() && isValidId(recordingId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(recordingId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'studioType', 'localFilePath',
                           'durationSeconds', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'studioType', 'localFilePath', 'durationSeconds',
                           'estimatedWpm', 'fillerWordsCount', 'framingPreset', 'aiFeedback',
                           'personalNotes', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidStudioRecording(incoming());

        allow update: if isSignedIn() &&
                         isValidId(recordingId) &&
                         request.auth.uid == userId &&
                         isValidStudioRecording(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'estimatedWpm', 'fillerWordsCount', 'aiFeedback', 'personalNotes', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(recordingId) && request.auth.uid == userId;
      }

      // 5. Career Center items subcollection
      match /career_items/{itemId} {
        allow get: if isSignedIn() && isValidId(itemId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(itemId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'itemType', 'title', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly([
                           'userId', 'itemType', 'title', 'subtitle', 'status', 'notes', 'mediaUri', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidCareerItem(incoming());

        allow update: if isSignedIn() &&
                         isValidId(itemId) &&
                         request.auth.uid == userId &&
                         isValidCareerItem(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'subtitle', 'status', 'notes', 'mediaUri', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(itemId) && request.auth.uid == userId;
      }
    }

    // 6. Moderated Global Actor Community Posts
    match /community_posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) &&
                    (existing().isHidden == false || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (existing().isHidden == false || existing().userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().isHidden == false &&
                       incoming().likesCount == 0 &&
                       incoming().reportCount == 0 &&
                       incoming().keys().hasAll([
                         'userId', 'authorStageName', 'country', 'language', 'category',
                         'title', 'body', 'likesCount', 'reportCount', 'isHidden', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'authorStageName', 'country', 'language', 'category',
                         'title', 'body', 'likesCount', 'reportCount', 'isHidden', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidCommunityPost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidCommunityPost(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         isAdmin() ||
                         // Author edit
                         (
                           existing().userId == request.auth.uid &&
                           incoming().isHidden == existing().isHidden &&
                           incoming().likesCount == existing().likesCount &&
                           incoming().reportCount == existing().reportCount &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'category', 'updatedAt'])
                         ) ||
                         // Community like action
                         (
                           existing().isHidden == false &&
                           incoming().isHidden == existing().isHidden &&
                           incoming().likesCount == existing().likesCount + 1 &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
                         ) ||
                         // Community flag/report counter action
                         (
                           existing().isHidden == false &&
                           incoming().isHidden == existing().isHidden &&
                           incoming().reportCount == existing().reportCount + 1 &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['reportCount', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(postId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 7. Community Reports
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || existing().reporterId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().keys().hasAll(['reporterId', 'postId', 'reason', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['reporterId', 'postId', 'reason', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidModerationReport(incoming()) &&
                       exists(/databases/$(database)/documents/community_posts/$(incoming().postId));

      allow update: if isAdmin() &&
                       isValidId(reportId) &&
                       isValidModerationReport(incoming()) &&
                       incoming().reporterId == existing().reporterId &&
                       incoming().postId == existing().postId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(reportId);
    }

    // 8. Admin-managed Custom Exercises
    match /custom_exercises/{exerciseId} {
      allow get: if isSignedIn() && isValidId(exerciseId) && (existing().isPublished == true || isAdmin());
      allow list: if isSignedIn() && (existing().isPublished == true || isAdmin());

      allow create: if isAdmin() &&
                       isValidId(exerciseId) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().keys().hasAll([
                         'title', 'departmentId', 'difficulty', 'durationSeconds',
                         'instructions', 'isPublished', 'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'departmentId', 'difficulty', 'durationSeconds',
                         'instructions', 'correctTechnique', 'commonMistakes', 'objective',
                         'isPublished', 'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidCustomExercise(incoming());

      allow update: if isAdmin() &&
                       isValidId(exerciseId) &&
                       isValidCustomExercise(incoming()) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

      allow delete: if isAdmin() && isValidId(exerciseId);
    }

    // 9. Admin Roles Registry
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }
  }
}
